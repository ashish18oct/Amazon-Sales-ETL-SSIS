              SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT * FROM INFORMATION_SCHEMA.TABLES &#xA;    WHERE TABLE_SCHEMA = 'dwh' AND TABLE_NAME = 'FactSales_LookupRejects'&#xA;)&#xA;BEGIN&#xA;&#xA;CREATE TABLE dwh.FactSales_LookupRejects (&#xA;    RejectID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    RejectSource VARCHAR(50),       -- Which lookup failed (e.g., ProductKey)&#xA;    Reason VARCHAR(512),            -- Custom message&#xA;    RejectedData NVARCHAR(MAX),     -- Concatenated input row details&#xA;    RejectedAt DATETIME DEFAULT GETDATE()&#xA;);&#xA;&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
