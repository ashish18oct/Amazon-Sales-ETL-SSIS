          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{17479D64-8894-44CE-A8DA-299E6BE724D0}"
              SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT * FROM INFORMATION_SCHEMA.TABLES &#xA;    WHERE TABLE_SCHEMA = 'ods' AND TABLE_NAME = 'sales_summary'&#xA;)&#xA;BEGIN&#xA;&#x9;CREATE TABLE ods.sales_summary (&#xA;&#x9;&#x9;Category VARCHAR(50),&#xA;&#x9;&#x9;Date DATE,&#xA;&#x9;&#x9;TotalQty INT,&#xA;&#x9;&#x9;TotalAmount DECIMAL(18,2),&#xA;&#x9;&#x9;OrderCount INT&#xA;&#x9;);&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
