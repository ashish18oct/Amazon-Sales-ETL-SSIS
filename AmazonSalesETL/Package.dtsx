              SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT * FROM INFORMATION_SCHEMA.TABLES &#xA;    WHERE TABLE_SCHEMA = 'dwh' AND TABLE_NAME = 'DimTime'&#xA;)&#xA;BEGIN&#xA;&#xA;CREATE TABLE dwh.DimTime (&#xA;    TimeKey INT IDENTITY(1,1) PRIMARY KEY,&#xA;    Date DATE NOT NULL,&#xA;    Day VARCHAR(50),&#xA;    Month INT,&#xA;    Quarter VARCHAR(10),&#xA;    Year INT,&#xA;    Week INT&#xA;);&#xA;&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
