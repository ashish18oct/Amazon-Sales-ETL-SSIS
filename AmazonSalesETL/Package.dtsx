              SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT * FROM INFORMATION_SCHEMA.TABLES &#xA;    WHERE TABLE_SCHEMA = 'dwh' AND TABLE_NAME = 'DimLocation'&#xA;)&#xA;BEGIN&#xA;&#xA;CREATE TABLE dwh.DimLocation (&#xA;    LocationKey INT IDENTITY(1,1) PRIMARY KEY,&#xA;    City VARCHAR(100),&#xA;    State VARCHAR(50),&#xA;    PostalCode VARCHAR(20),&#xA;    Country VARCHAR(50),&#xA;);&#xA;&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
