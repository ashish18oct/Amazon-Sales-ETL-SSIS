          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{17479D64-8894-44CE-A8DA-299E6BE724D0}"
              SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT * FROM INFORMATION_SCHEMA.TABLES &#xA;    WHERE TABLE_SCHEMA = 'dwh' AND TABLE_NAME = 'FactSales'&#xA;)&#xA;BEGIN&#xA;&#xA;CREATE TABLE dwh.FactSales (&#xA;    SalesKey INT IDENTITY(1,1) PRIMARY KEY,&#xA;    ProductKey INT,&#xA;    TimeKey INT,&#xA;    LocationKey INT,&#xA;    SalesChannelKey INT,&#xA;    OrderStatusKey INT,&#xA;    Quantity INT,&#xA;    Amount DECIMAL(10,2),&#xA;    &#xA;    -- Foreign Key Constraints&#xA;    CONSTRAINT FK_FactSales_Product FOREIGN KEY (ProductKey)&#xA;        REFERENCES dwh.DimProduct(ProductKey),&#xA;    &#xA;    CONSTRAINT FK_FactSales_Time FOREIGN KEY (TimeKey)&#xA;        REFERENCES dwh.DimTime(TimeKey),&#xA;    &#xA;    CONSTRAINT FK_FactSales_Location FOREIGN KEY (LocationKey)&#xA;        REFERENCES dwh.DimLocation(LocationKey),&#xA;    &#xA;    CONSTRAINT FK_FactSales_SalesChannel FOREIGN KEY (SalesChannelKey)&#xA;        REFERENCES dwh.DimSalesChannel(SalesChannelKey),&#xA;    &#xA;    CONSTRAINT FK_FactSales_OrderStatus FOREIGN KEY (OrderStatusKey)&#xA;        REFERENCES dwh.DimOrderStatus(OrderStatusKey)&#xA;);&#xA;&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
